# ═══════════════════════════════════════════
# SatQuery Root Environment Variables
# ═══════════════════════════════════════════

# Database
POSTGRES_USER=satquery
POSTGRES_PASSWORD=satquery_dev_password
POSTGRES_DB=satquery
DATABASE_URL=postgresql+asyncpg://satquery:satquery_dev_password@db:5432/satquery

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MODEL_SERVER_URL=http://model-server:8001
UPLOAD_DIR=/app/uploads

# Model Server
MODEL_SERVER_HOST=0.0.0.0
MODEL_SERVER_PORT=8001
MOCK_MODELS=true

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
